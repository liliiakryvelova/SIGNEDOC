# Copy to .env for local tools. Never use these local values in Azure.
POSTGRES_USER=signedoc
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://signedoc:local-only-change-me@localhost:5432/signedoc
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT=
# Generate a random secret of at least 32 characters for local development.
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
JWT_ISSUER=signedoc-local
JWT_AUDIENCE=signedoc-web
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=10485760